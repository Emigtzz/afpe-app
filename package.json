{
  "name": "afpe-app",
  "version": "0.1.0",
  "description": "App de Finanzas Personales para Estudiantes - AFPE",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:update": "jest --updateSnapshot",
    "lint": "eslint src/ --max-warnings 10",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "validate": "npm run lint && npm run test && npm run format:check",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "setup": "bash setup.sh",
    "setup:firebase": "bash setup-firebase.sh",
    "onboarding": "bash onboarding.sh"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.0",
    "expo": "~50.0.0",
    "expo-status-bar": "~1.11.0",
    "expo-notifications": "~0.27.0",
    "firebase": "^10.7.0",
    "zustand": "^4.4.0",
    "@react-native-async-storage/async-storage": "1.21.1",
    "react-navigation": "^4.4.4",
    "@react-navigation/native": "^4.11.14",
    "@react-navigation/bottom-tabs": "^5.11.19",
    "@react-navigation/stack": "^5.14.30",
    "react-native-screens": "~3.29.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-paper": "^5.11.4",
    "react-native-vector-icons": "^10.0.0",
    "react-native-svg": "14.1.0",
    "react-native-svg-charts": "^5.4.0",
    "react-native-chart-kit": "^6.12.0",
    "axios": "^1.6.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "redux-persist": "^6.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.0",
    "@testing-library/jest-native": "^5.4.3",
    "prettier": "^3.1.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-native": "^4.1.0"
  },
  "private": true,
  "keywords": [
    "react-native",
    "expo",
    "mobile",
    "finance",
    "personal-finance"
  ]
}
